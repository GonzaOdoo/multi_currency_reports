<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="general_ledger_report_balance_usd_value" model="account.report.column">
        <field name="name">Valor USD</field>
        <field name="expression_label">balance_usd_value</field>
        <field name="figure_type">monetary</field>
    </record>

    <record id="account_reports.general_ledger_report" model="account.report">
        <field name="column_ids" eval="[
            (4, ref('discount_button_on_invoice.general_ledger_report_balance_usd_value')),
        ]"/>
    </record>

    <record id="general_ledger_line_balance_usd_value" model="account.report.expression">
        <field name="report_line_id" ref="account_reports.general_ledger_custom_engine_line"/>
        <field name="label">balance_usd_value</field>
        <field name="engine">custom</field>
        <field name="formula">_report_custom_engine_general_ledger</field>
        <field name="subformula">balance_usd_value</field>
    </record>

    <record id="general_ledger_line_balance_usd_value_currency" model="account.report.expression">
        <field name="report_line_id" ref="account_reports.general_ledger_custom_engine_line"/>
        <field name="label">_currency_balance_usd_value</field>
        <field name="engine">custom</field>
        <field name="formula">_report_custom_engine_general_ledger</field>
        <field name="subformula">balance_usd_currency_id</field>
    </record>
</odoo>