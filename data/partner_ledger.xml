<odoo>

    <record id="partner_ledger_report_balance_current" model="account.report.column">
        <field name="name">Valor Actual</field>
        <field name="expression_label">balance_current</field>
    </record>

    <record id="partner_ledger_report_balance_usd_current" model="account.report.column">
        <field name="name">Valorización USD Actual</field>
        <field name="expression_label">balance_usd_current</field>
    </record>

    <record id="account_reports.partner_ledger_report" model="account.report">
        <field name="column_ids" eval="[
            (4, ref('discount_button_on_invoice.partner_ledger_report_balance_current')),
            (4, ref('discount_button_on_invoice.partner_ledger_report_balance_usd_current'))
        ]"/>
    </record>

</odoo>