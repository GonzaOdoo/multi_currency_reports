<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Lista -->
    <record id="view_account_report_currency_group_list" model="ir.ui.view">
        <field name="name">account.report.currency.group.list</field>
        <field name="model">account.report.currency.group</field>
        <field name="arch" type="xml">
            <list default_order="sequence, id">
                <field name="sequence"/>
                <field name="name"/>
                <field name="currency_ids" widget="many2many_tags"/>
                <field name="reference_currency_id"/>
            </list>
        </field>
    </record>

    <!-- Formulario -->
    <record id="view_account_report_currency_group_form" model="ir.ui.view">
        <field name="name">account.report.currency.group.form</field>
        <field name="model">account.report.currency.group</field>
        <field name="arch" type="xml">
            <form string="Grupo de monedas">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="reference_currency_id"/>
                        </group>
                    </group>

                    <group string="Monedas del grupo">
                        <field name="currency_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción -->
    <record id="action_account_report_currency_group" model="ir.actions.act_window">
        <field name="name">Grupos de monedas</field>
        <field name="res_model">account.report.currency.group</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear un grupo de monedas
            </p>
            <p>
                Configure las monedas que deben mostrarse sin conversión
                en los reportes contables.
            </p>
        </field>
    </record>

    <!-- Menú -->
    <menuitem
        id="menu_account_report_currency_group"
        name="Grupos de monedas"
        parent="account.menu_finance_configuration"
        action="action_account_report_currency_group"
        sequence="90"
    />

</odoo>