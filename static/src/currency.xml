<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="multi_currency_reports.AccountReportCurrencyGroupsData">
        <Dropdown>
            <button class="btn btn-secondary">
                <i class="fa fa-money me-1"/>
                <t t-out="controller.options.selected_currency_group_name"/>
            </button>
            <t t-set-slot="content">
                <t t-foreach="controller.options.currency_groups" t-as="currency_group" t-key="currency_group.id">
                    <DropdownItem
                        class="{ 'selected': this.isCurrencyGroupSelected(currency_group), 'ps-4': true }"
                        onSelected="() => this.onSelectCurrencyGroup(currency_group)"
                    >
                        <t t-esc="currency_group.name"/>
                    </DropdownItem>
                </t>
            </t>
        </Dropdown>
    </t>

    <t t-name="multi_currency_reports.OnlyUsdFilterData">
        <Dropdown>
            <button class="btn btn-secondary">
                <i class="fa fa-filter me-1"/>
                Filtro
            </button>
            <t t-set-slot="content">
                <DropdownItem
                    class="{ selected: onlyUsd, 'ps-4': true }"
                    onSelected="() => this.setOnlyUsd(!onlyUsd)"
                >
                    <i t-if="onlyUsd" class="fa fa-check me-2"/>
                    Sólo movimientos en USD
                </DropdownItem>
            </t>
        </Dropdown>
    </t>
</templates>