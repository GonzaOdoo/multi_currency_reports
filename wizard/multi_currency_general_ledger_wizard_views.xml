<odoo>
    <record id="view_multi_currency_general_ledger_wizard_form" model="ir.ui.view">
        <field name="name">multi.currency.general.ledger.wizard.form</field>
        <field name="model">multi.currency.general.ledger.wizard</field>
        <field name="arch" type="xml">
            <form string="Multi Currency General Ledger">
                <group>
                    <group>
                        <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="target_move" widget="radio"/>
                        <field name="display_account" widget="radio"/>
                        <field name="show_init_balance"/>
                    </group>
                    <group>
                        <field name="account_type_asset"/>
                        <field name="account_type_liability"/>
                        <field name="account_type_equity"/>
                        <field name="account_type_income"/>
                        <field name="account_type_expense"/>
                        <field name="account_type_other"/>
                    </group>

                    <group string="Accounts" name="accounts">
                        <field name="account_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <p class="text-muted">Leave empty to get all accounts</p>
                    </group>
                    <group string="Journals" name="journals">
                        <field name="journal_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <p class="text-muted">Leave empty to get all journals</p>
                    </group>
                    <group string="Currencies" name="currencies">
                        <field name="currency_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <p class="text-muted">Leave empty to get all currencies</p>
                    </group>
                </group>
                <footer>
                    <button name="action_print_pdf" string="Print PDF" type="object" class="btn-primary" data-hotkey="p"/>
                    <button name="action_export_xlsx" string="Export to Excel" type="object" class="btn-secondary" data-hotkey="e"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_multi_currency_general_ledger_wizard" model="ir.actions.act_window">
        <field name="name">Multi Currency General Ledger</field>
        <field name="res_model">multi.currency.general.ledger.wizard</field>
        <field name="view_mode">form</field>
        <field name="path">multi_currency_general_ledger_wizard</field>
        <field name="target">new</field>
    </record>
</odoo>
